  "ng-1user-2-credentials": {
    "scope": "typescript",
    "prefix": "ng-1user-2-credentials",
    "description": "credentials",
    "body": [
      "findByCredentials(email: string, password: string): Observable<User | null> {",
      "  return defer(() =>",
      "    from(",
      "      this.supabaseService.client",
      "        .from(this.TABLE)",
      "        .select('id, name, email, rol')",
      "        .eq('email', email)",
      "        .eq('password', password)",
      "        .maybeSingle(),",
      "    ),",
      "  ).pipe(",
      "    map(({ data, error }) => {",
      "      if (error) {",
      "        throw new Error(error.message);",
      "      }",
      "      return (data as User | null) ?? null;",
      "    }),",
      "  );",
      "}"
    ]
  },
  "ng-2auth-1-class": {
    "scope": "typescript",
    "prefix": "ng-2auth-1-class",
    "description": "class",
    "body": [
      "@Injectable({ providedIn: 'root' })",
      "export class AuthService {",
      "  private userService = inject(UserService);",
      "",
      "  isAuthenticated = signal<boolean>(localStorage.getItem('session') === 'true');",
      "  currentRol = signal<string | null>(localStorage.getItem('rol'));",
      "",
      "  $0",
      "}"
    ]
  },
  "ng-2auth-2-login": {
    "scope": "typescript",
    "prefix": "ng-2auth-2-login",
    "description": "login",
    "body": [
      "login(email: string, password: string): Observable<boolean> {",
      "  return this.userService.findByCredentials(email, password).pipe(",
      "    map((user) => {",
      "      if (!user) {",
      "        return false;",
      "      }",
      "      const { password: _password, ...safeUser } = user;",
      "      localStorage.setItem('session', 'true');",
      "      localStorage.setItem('user', JSON.stringify(safeUser));",
      "      localStorage.setItem('rol', user.rol);",
      "      this.isAuthenticated.set(true);",
      "      this.currentRol.set(user.rol);",
      "      return true;",
      "    }),",
      "  );",
      "}"
    ]
  },
  "ng-2auth-3-logout": {
    "scope": "typescript",
    "prefix": "ng-2auth-3-logout",
    "description": "logout",
    "body": [
      "logout(): void {",
      "  localStorage.removeItem('session');",
      "  localStorage.removeItem('user');",
      "  localStorage.removeItem('rol');",
      "  this.isAuthenticated.set(false);",
      "  this.currentRol.set(null);",
      "}"
    ]
  },
  "ng-2auth-4-current": {
    "scope": "typescript",
    "prefix": "ng-2auth-4-current",
    "description": "current",
    "body": [
      "currentUser(): Omit<User, 'password'> | null {",
      "  const raw = localStorage.getItem('user');",
      "  if (!raw) {",
      "    return null;",
      "  }",
      "  try {",
      "    return JSON.parse(raw);",
      "  } catch {",
      "    return null;",
      "  }",
      "}"
    ]
  },
