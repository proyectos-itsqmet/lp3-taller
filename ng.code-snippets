      "      <button type=\"button\" (click)=\"reset()\"",
      "        class=\"border border-slate-300 px-4 py-2 rounded font-semibold shadow-md hover:shadow-lg cursor-pointer\">",
      "        Cancelar",
      "      </button>",
      "    </div>",
      "  </form>",
      "",
      "  <div class=\"bg-white border border-slate-200 rounded-lg shadow-md overflow-x-auto\">",
      "    <table class=\"w-full text-sm text-left\">",
      "      <thead class=\"bg-main text-white\">",
      "        <tr>",
      "          <th class=\"px-4 py-3\">Nombre</th>",
      "          <th class=\"px-4 py-3\">Formato</th>",
      "          <th class=\"px-4 py-3\">Año</th>",
      "          <th class=\"px-4 py-3\">Género</th>",
      "          <th class=\"px-4 py-3\">Calificación</th>",
      "          <th class=\"px-4 py-3\">Acciones</th>",
      "        </tr>",
      "      </thead>",
      "      <tbody>",
      "        @for (item of list(); track item.id) {",
      "          <tr class=\"border-t border-slate-200\">",
      "            <td class=\"px-4 py-3 font-medium\">{{ item.name }}</td>",
      "            <td class=\"px-4 py-3\">{{ item.format === 'ALBUM' ? 'Álbum' : 'EP' }}</td>",
      "            <td class=\"px-4 py-3\">{{ item.year }}</td>",
      "            <td class=\"px-4 py-3\">{{ item.genre }}</td>",
      "            <td class=\"px-4 py-3\">★ {{ item.rating }}/10</td>",
      "            <td class=\"px-4 py-3 whitespace-nowrap space-x-2\">",
      "              <button type=\"button\" (click)=\"selectForEdit(item)\"",
      "                class=\"border border-main text-main px-3 py-1 rounded shadow-md hover:shadow-lg cursor-pointer\">Editar</button>",
      "              <button type=\"button\" (click)=\"delete(item.id)\"",
      "                class=\"bg-main text-white px-3 py-1 rounded shadow-md hover:bg-main-dark hover:shadow-lg cursor-pointer\">Eliminar</button>",
      "            </td>",
      "          </tr>",
      "        } @empty {",
      "          <tr>",
      "            <td colspan=\"6\" class=\"px-4 py-6 text-center text-slate-500\">No hay registros</td>",
      "          </tr>",
      "        }",
      "      </tbody>",
      "    </table>",
      "  </div>",
      "</section>"
    ]
  }
}
