  "ng-6admin-1-ts": {
    "scope": "typescript",
    "prefix": "ng-6admin-1-ts",
    "description": "admin",
    "body": [
      "import { Component, inject, OnInit, signal } from '@angular/core';",
      "import { FormsModule } from '@angular/forms';",
      "import { Album } from '../../models/album';",
      "import { AlbumService } from '../../services/album-service';",
      "",
      "@Component({",
      "  selector: 'app-admin',",
      "  imports: [FormsModule],",
      "  templateUrl: './admin.html',",
      "  styleUrl: './admin.css',",
      "})",
      "export class Admin implements OnInit {",
      "  private service = inject(AlbumService);",
      "",
      "  list = signal<Album[]>([]);",
      "  newItem: Album = this.emptyItem();",
      "  editing = false;",
      "",
      "  ngOnInit() {",
      "    this.load();",
      "  }",
      "",
      "  private emptyItem(): Album {",
      "    return { name: '', format: 'ALBUM', year: 2024, genre: '', description: '', rating: 5, coverUrl: '' };",
      "  }",
      "",
      "  load() {",
      "    this.service.getAll().subscribe({",
      "      next: (data) => this.list.set(data),",
      "      error: () => alert('No se pudo cargar los registros. ¿Está corriendo json-server?'),",
      "    });",
      "  }",
      "",
      "  selectForEdit(item: Album) {",
      "    this.editing = true;",
      "    this.newItem = { ...item };",
      "  }",
      "",
      "  save() {",
      "    const request =",
      "      this.editing && this.newItem.id !== undefined",
      "        ? this.service.put(this.newItem.id, this.newItem)",
      "        : this.service.post(this.newItem);",
      "    request.subscribe({",
      "      next: () => {",
      "        this.load();",
      "        this.reset();",
      "      },",
      "      error: () => alert('No se pudo guardar el registro'),",
      "    });",
      "  }",
      "",
      "  delete(id?: number) {",
      "    if (id === undefined || !confirm('¿Desea eliminar el registro?')) {",
      "      return;",
      "    }",
      "    this.service.delete(id).subscribe({",
      "      next: () => this.load(),",
      "      error: () => alert('No se pudo eliminar el registro'),",
      "    });",
      "  }",
      "",
      "  reset() {",
      "    this.editing = false;",
      "    this.newItem = this.emptyItem();",
      "  }",
      "}"
    ]
  },
