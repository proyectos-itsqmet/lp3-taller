  },
  "sbt-7html-2-navlink": {
    "scope": "html",
    "prefix": "sbt-7html-2-navlink",
    "description": "navlink",
    "body": [
      "<a class=\"btn btn-sm btn-outline-light\" th:href=\"@{/${1:sesiones}}\">${2:Sesiones}</a>"
    ]
  },
  "sbt-7html-3-buscar": {
    "scope": "html",
    "prefix": "sbt-7html-3-buscar",
    "description": "search",
    "body": [
      "<form th:action=\"@{/${1:socios}}\" method=\"get\" class=\"d-flex mb-3\">",
      "    <input type=\"text\" name=\"string\" th:value=\"\\${string}\" class=\"form-control me-2\" placeholder=\"Buscar\">",
      "    <button type=\"submit\" class=\"btn btn-secondary\">Buscar</button>",
      "</form>"
    ]
  },
  "sbt-7html-4-tabla": {
    "scope": "html",
    "prefix": "sbt-7html-4-tabla",
    "description": "table",
    "body": [
      "<a th:href=\"@{/${1:socios}/nuevo}\" class=\"btn btn-primary mb-3\">Nuevo</a>",
      "",
      "<table class=\"table table-striped\">",
      "    <thead>",
      "    <tr>",
      "        <th>ID</th>",
      "        <th>String</th>",
      "        <th>Integer</th>",
      "        <th>Long</th>",
      "        <th>Double</th>",
      "        <th>BigDecimal</th>",
      "        <th>Boolean</th>",
      "        <th>LocalDate</th>",
      "        <th>LocalDateTime</th>",
      "        <th>Acciones</th>",
      "    </tr>",
      "    </thead>",
      "    <tbody>",
      "    <tr th:each=\"e : \\${$1}\">",
      "        <td th:text=\"\\${e.id}\"></td>",
      "        <td th:text=\"\\${e.string}\"></td>",
      "        <td th:text=\"\\${e.integer}\"></td>",
      "        <td th:text=\"\\${e.longValue}\"></td>",
      "        <td th:text=\"\\${e.doubleValue}\"></td>",
      "        <td th:text=\"\\${e.bigDecimal}\"></td>",
      "        <td th:text=\"\\${e.booleanValue}\"></td>",
      "        <td th:text=\"\\${e.localDate}\"></td>",
      "        <td th:text=\"\\${e.localDateTime}\"></td>",
      "        <td>",
      "            <a th:href=\"@{/$1/editar/{id}(id=\\${e.id})}\" class=\"btn btn-sm btn-warning\">Editar</a>",
      "            <form th:action=\"@{/$1/eliminar/{id}(id=\\${e.id})}\" method=\"post\" class=\"d-inline\">",
      "                <button type=\"submit\" class=\"btn btn-sm btn-danger\">Eliminar</button>",
      "            </form>",
      "        </td>",
      "    </tr>",
      "    <tr th:if=\"\\${#lists.isEmpty($1)}\">",
      "        <td colspan=\"10\">No hay registros</td>",
      "    </tr>",
      "    </tbody>",
      "</table>"
    ]
  },
  "sbt-7html-5-form": {
    "scope": "html",
    "prefix": "sbt-7html-5-form",
    "description": "form",
    "body": [
      "<form th:action=\"@{/${2:socios}/guardar}\" th:object=\"\\${${1:socio}}\" method=\"post\">",
      "    <input type=\"hidden\" th:field=\"*{id}\">",
      "",
      "    <div class=\"mb-3\">",
      "        <label class=\"form-label\">String</label>",
      "        <input type=\"text\" th:field=\"*{string}\" class=\"form-control\">",
      "        <div class=\"text-danger\" th:if=\"\\${#fields.hasErrors('string')}\" th:errors=\"*{string}\"></div>",
      "    </div>",
      "    <div class=\"mb-3\">",
      "        <label class=\"form-label\">Integer</label>",
      "        <input type=\"number\" th:field=\"*{integer}\" class=\"form-control\">",
      "        <div class=\"text-danger\" th:if=\"\\${#fields.hasErrors('integer')}\" th:errors=\"*{integer}\"></div>",
      "    </div>",
      "    <div class=\"mb-3\">",
      "        <label class=\"form-label\">Long</label>",
      "        <input type=\"number\" th:field=\"*{longValue}\" class=\"form-control\">",
      "        <div class=\"text-danger\" th:if=\"\\${#fields.hasErrors('longValue')}\" th:errors=\"*{longValue}\"></div>",
      "    </div>",
      "    <div class=\"mb-3\">",
      "        <label class=\"form-label\">Double</label>",
      "        <input type=\"number\" step=\"any\" th:field=\"*{doubleValue}\" class=\"form-control\">",
      "        <div class=\"text-danger\" th:if=\"\\${#fields.hasErrors('doubleValue')}\" th:errors=\"*{doubleValue}\"></div>",
      "    </div>",
      "    <div class=\"mb-3\">",
      "        <label class=\"form-label\">BigDecimal</label>",
      "        <input type=\"number\" step=\"0.01\" th:field=\"*{bigDecimal}\" class=\"form-control\">",
      "        <div class=\"text-danger\" th:if=\"\\${#fields.hasErrors('bigDecimal')}\" th:errors=\"*{bigDecimal}\"></div>",
      "    </div>",
      "    <div class=\"mb-3 form-check\">",
      "        <input type=\"checkbox\" th:field=\"*{booleanValue}\" class=\"form-check-input\">",
      "        <label class=\"form-check-label\">Boolean</label>",
      "    </div>",
      "    <div class=\"mb-3\">",
      "        <label class=\"form-label\">LocalDate</label>",
      "        <input type=\"date\" th:field=\"*{localDate}\" class=\"form-control\">",
      "        <div class=\"text-danger\" th:if=\"\\${#fields.hasErrors('localDate')}\" th:errors=\"*{localDate}\"></div>",
      "    </div>",
      "    <div class=\"mb-3\">",
      "        <label class=\"form-label\">LocalDateTime</label>",
      "        <input type=\"datetime-local\" th:field=\"*{localDateTime}\" class=\"form-control\">",
      "        <div class=\"text-danger\" th:if=\"\\${#fields.hasErrors('localDateTime')}\" th:errors=\"*{localDateTime}\"></div>",
      "    </div>",
      "",
      "    <button type=\"submit\" class=\"btn btn-success\">Guardar</button>",
      "    <a th:href=\"@{/$2}\" class=\"btn btn-secondary\">Cancelar</a>",
      "</form>"
    ]
  },
  "sbt-7html-6-field": {
    "scope": "html",
    "prefix": "sbt-7html-6-field",
    "description": "field",
    "body": [
      "<div class=\"mb-3\">",
      "    <label class=\"form-label\">${1:Campo}</label>",
      "    <input type=\"${2|text,number,date,datetime-local,email,password|}\" th:field=\"*{${3:campo}}\" class=\"form-control\">",
      "    <div class=\"text-danger\" th:if=\"\\${#fields.hasErrors('$3')}\" th:errors=\"*{$3}\"></div>",
      "</div>"
    ]
  },
  "sbt-7html-7-select": {
    "scope": "html",
    "prefix": "sbt-7html-7-select",
    "description": "select",
    "body": [
      "<div class=\"mb-3\">",
      "    <label class=\"form-label\">${1:Socio}</label>",
      "    <select name=\"${2:socio}Id\" class=\"form-select\" required>",
      "        <option value=\"\">Seleccione...</option>",
      "        <option th:each=\"o : \\${${3:socios}}\" th:value=\"\\${o.id}\" th:text=\"\\${o.string}\"></option>",
      "    </select>",
      "</div>"
    ]
  },
  "sbt-7html-8-login": {
    "scope": "html",
    "prefix": "sbt-7html-8-login",
    "description": "login",
    "body": [
      "<!DOCTYPE html>",
      "<html xmlns:th=\"http://www.thymeleaf.org\">",
      "<head>",
      "    <meta charset=\"UTF-8\">",
      "    <title>Login</title>",
      "    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css\">",
      "</head>",
      "<body class=\"bg-light\">",
      "<div class=\"container mt-5\" style=\"max-width: 400px;\">",
      "    <h3 class=\"mb-3\">${1:Gimnasio} - Iniciar sesión</h3>",
      "",
      "    <div th:if=\"\\${param.error}\" class=\"alert alert-danger\">Usuario o contraseña incorrectos</div>",
      "    <div th:if=\"\\${param.logout}\" class=\"alert alert-success\">Sesión cerrada</div>",
      "",
      "    <form th:action=\"@{/login}\" method=\"post\">",
      "        <div class=\"mb-3\">",
      "            <label class=\"form-label\">Usuario</label>",
      "            <input type=\"text\" name=\"username\" class=\"form-control\" required>",
      "        </div>",
      "        <div class=\"mb-3\">",
      "            <label class=\"form-label\">Contraseña</label>",
      "            <input type=\"password\" name=\"password\" class=\"form-control\" required>",
      "        </div>",
      "        <button type=\"submit\" class=\"btn btn-primary w-100\">Ingresar</button>",
      "    </form>",
      "</div>",
      "</body>",
      "</html>"
    ]
  }
}
