      "                    .permitAll())",
      "            .logout(logout -> logout",
      "                    .logoutSuccessUrl(\"/login?logout\")",
      "                    .permitAll());",
      "",
      "    return http.build();",
      "}"
    ]
  },
  "sbt-7html-1-page": {
    "scope": "html",
    "prefix": "sbt-7html-1-page",
