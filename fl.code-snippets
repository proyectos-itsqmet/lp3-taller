{
  "fl-0cfg-1-appenv": {
    "scope": "dart",
    "prefix": "fl-0cfg-1-appenv",
    "description": "appenv",
    "body": [
      "abstract final class AppEnv {",
      "  static String get projectUrl => dotenv.get('PROJECT_URL');",
      "  static String get publishableKey => dotenv.get('PUBLISHABLE_KEY');",
      "  static String get ${1:restCountriesKey} => dotenv.get('${2:REST_COUNTRIES_KEY}');",
      "}"
    ]
  },
  "fl-0cfg-2-init": {
    "scope": "dart",
    "prefix": "fl-0cfg-2-init",
    "description": "init",
    "body": [
      "WidgetsFlutterBinding.ensureInitialized();",
      "await dotenv.load();",
      "await Supabase.initialize(",
      "  url: AppEnv.projectUrl,",
      "  publishableKey: AppEnv.publishableKey,",
      ");"
    ]
  },
  "fl-1auth-1-class": {
    "scope": "dart",
    "prefix": "fl-1auth-1-class",
    "description": "class",
    "body": [
      "class AuthService {",
      "  final _supabase = Supabase.instance.client;",
      "",
      "  User? get usuario => _supabase.auth.currentUser;",
      "",
      "  $0",
      "}"
    ]
  },
  "fl-1auth-2-registrar": {
    "scope": "dart",
    "prefix": "fl-1auth-2-registrar",
    "description": "register",
    "body": [
      "Future<void> registrar(String nombre, String email, String password) async {",
      "  await _supabase.auth.signUp(",
      "    password: password,",
      "    email: email,",
      "    data: {'nombre': nombre},",
      "  );",
      "}"
    ]
  },
  "fl-1auth-3-login": {
    "scope": "dart",
    "prefix": "fl-1auth-3-login",
    "description": "login",
    "body": [
      "Future<void> login(String email, String password) async {",
      "  await _supabase.auth.signInWithPassword(password: password, email: email);",
      "}"
    ]
  },
  "fl-1auth-4-logout": {
    "scope": "dart",
    "prefix": "fl-1auth-4-logout",
    "description": "logout",
    "body": [
      "Future<void> logout() async {",
      "  await _supabase.auth.signOut();",
      "}"
    ]
  },
  "fl-2api-1-class": {
    "scope": "dart",
